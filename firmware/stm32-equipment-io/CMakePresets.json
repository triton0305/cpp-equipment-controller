{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Dht11Hardware",
            "inherits": "Debug",
            "description": "Isolated DHT11 bench harness; production runtime disabled",
            "cacheVariables": {
                "DHT11_HARDWARE_TEST": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "StepperHardware",
            "inherits": "Debug",
            "description": "Isolated stepper bench; explicit UART start, production runtime disabled",
            "cacheVariables": {
                "STEPPER_HARDWARE_TEST": "ON",
                "DHT11_HARDWARE_TEST": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Dht11Hardware",
            "configurePreset": "Dht11Hardware"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "StepperHardware",
            "configurePreset": "StepperHardware"
        }
    ]
}
